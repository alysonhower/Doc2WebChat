{
  "schema_version": 1,
  "providers": [
    {
      "id": "ai-studio",
      "label": "AI Studio",
      "adapter_key": "ai_studio",
      "canonical_url": "https://aistudio.google.com/prompts/new_chat",
      "allowed_url_prefixes": ["https://aistudio.google.com/"],
      "manifest_matches": ["https://aistudio.google.com/*"],
      "detection": { "url_prefixes": ["https://aistudio.google.com/"] },
      "controls": {
        "model": {
          "values": {
            "gemini-3.5-flash": {
              "label": "Gemini 3.5 Flash",
              "reasoning_efforts": ["Minimal", "Low", "Medium", "High"]
            },
            "gemini-3.1-pro-preview": {
              "label": "Gemini 3.1 Pro Preview",
              "reasoning_efforts": ["Low", "Medium", "High"]
            },
            "gemini-3.1-flash-lite": {
              "label": "Gemini 3.1 Flash Lite",
              "reasoning_efforts": ["Minimal", "Low", "Medium", "High"]
            }
          }
        },
        "temperature": true,
        "top_p": true,
        "system_instructions": {
          "default": "You're a helpful document assistant."
        },
        "thinking_budget": true,
        "options": {
          "hide-panel": "Hide panel",
          "grounding-with-google-search": "Grounding with Google Search",
          "url-context": "URL context"
        }
      },
      "dom_controls": [
        "wait_until_ready",
        "system_instructions",
        "options",
        "temperature",
        "reasoning_effort",
        "thinking_budget",
        "top_p",
        "message",
        "response_observer",
        "native_copy"
      ]
    },
