{
  "manifest_version": 3,
  "author": "Robert Piosik",
  "name": "Ponte do navegador Doc2WebChat",
  "short_name": "Doc2WebChat",
  "description": "Preencha chats compatíveis na Web usando o aplicativo Doc2WebChat no seu computador.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:55155/*", "ws://127.0.0.1:55155/*"],
  "action": {
    "default_title": "Ponte do navegador Doc2WebChat",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": ["send-prompt-content-script.js"]
    }
  ]
}
