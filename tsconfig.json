{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@shared/*": ["packages/shared/src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  }
}
